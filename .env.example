HOST=127.0.0.1
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=awllahza
MYSQL_USER=awllahza
MYSQL_PASSWORD=replace-with-a-unique-password
# Required by Docker Compose; not used by the application database account.
MYSQL_ROOT_PASSWORD=replace-with-a-different-unique-password
ORDERING_ENABLED=true
# Local development only: true adds a visible test-order notice on customer screens.
TEST_MODE=true
# Production behind an HTTPS reverse proxy: set NODE_ENV=production and APP_ORIGIN=https://your-domain
# APP_DOMAIN=orders.example.com
